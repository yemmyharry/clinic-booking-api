PORT=3000
# Choose a private key for production and enter it in the web page's API Key settings.
API_KEY=koya-secret-key-123
# Required in production. Local development can omit it to use temporary memory storage.
DATABASE_URL=postgresql://user:password@localhost:5432/clinic_booking
# Set only for a PostgreSQL server that intentionally does not use TLS (e.g. a private network).
# DATABASE_SSL=false
# Render private connections use self-signed TLS certificates:
# DATABASE_SSL=require
# Optional URL for the demo seed script; the API serves the web page at the same URL.
# API_BASE_URL=http://localhost:3000
