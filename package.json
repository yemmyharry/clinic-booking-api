{
  "name": "clinic-booking-api",
  "version": "1.0.0",
  "description": "Clinic Booking API and Web Interface compliant with Koya Cohort 4 Assessment Specification",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r src/public dist/",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "engines": { "node": ">=22 <27" },
  "keywords": [
    "clinic",
    "booking",
    "api",
    "koya"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
